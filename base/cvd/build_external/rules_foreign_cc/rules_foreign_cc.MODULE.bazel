# OpenBSD support for rules_foreign_cc:
#  - the framework shell toolchain only knows linux/freebsd/macos/windows, so
#    every cmake()/configure_make() target fails toolchain resolution; add an
#    OpenBSD variant of the FreeBSD commands.
#  - use the packaged cmake/ninja/gmake instead of building them from source.
single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = ["@//build_external/rules_foreign_cc:openbsd.patch"],
)

register_toolchains("@//build_external/rules_foreign_cc:all")
