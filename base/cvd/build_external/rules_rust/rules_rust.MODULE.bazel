# crate_universe clones a git remote once per crate it provides, so a Cargo
# workspace hosted in git (crosvm: ~70 crates) is cloned ~70 times per build,
# which trips googlesource's rate limiting (b/574521063). This patch makes the
# extension share one checkout per (remote, commit) instead.
# See build_external/rules_rust/README.md.
# TODO: drop once the change is upstreamed in rules_rust.
#
# OpenBSD support for rules_rust (rust-lang.org publishes no OpenBSD binaries):
#  - know the x86_64/aarch64-unknown-openbsd triples and detect them as host;
#  - build the OpenBSD toolchain repositories from the sysroot of the rustc
#    found on the host (the ports/packages rust) instead of downloading;
#  - crate_universe builds cargo-bazel from source where there is no prebuilt
#    and generates the OpenBSD select() branches for the crate BUILD files.
single_version_override(
    module_name = "rules_rust",
    version = "0.68.1",
    patch_strip = 1,
    patches = [
        "@//build_external/rules_rust:0001-crate_universe-share-git-checkouts.patch",
        "@//build_external/rules_rust:openbsd.patch",
    ],
)
