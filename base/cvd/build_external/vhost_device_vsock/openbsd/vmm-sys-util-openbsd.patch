index 0000000..fe0c7d0
--- /dev/null
+++ b/src/bsd/eventfd.rs
@@ -0,0 +1,201 @@
+// Copyright 2026 Google LLC
+// SPDX-License-Identifier: BSD-3-Clause
+
+//! Structure and wrapper functions emulating `eventfd(2)` on hosts that do
+//! not have it (OpenBSD).
+//!
+//! An eventfd is a counter that readers wait on.  A `socketpair(2)` gives
+//! the same observable behaviour to the users of this crate: every `write`
+//! queues an 8-byte value, `read` drains what is queued and returns the sum
+//! (or one value in semaphore mode), and the read side is pollable.  An
+//! `EventFd` built from a foreign descriptor (`from_raw_fd`, e.g. a vring
+//! kick or call fd received over vhost-user) has a single descriptor and is
+//! used in one direction only; a pipe end works there because QEMU writes
+//! 8-byte values to its pipe-based notifiers as well.
+
+use std::fs::File;
+use std::io::{self, Read, Write};
+use std::os::fd::{AsRawFd, FromRawFd, IntoRawFd, RawFd};
+use std::result;
+
+use libc::{c_int, c_void, fcntl, poll, pollfd, socketpair, AF_UNIX, F_GETFL, F_SETFL, O_NONBLOCK,
+           POLLIN, SOCK_CLOEXEC, SOCK_STREAM};
+
+/// Flag: the read side is non-blocking.
+pub const EFD_NONBLOCK: i32 = O_NONBLOCK;
+/// Flag: close-on-exec (always set here).
+pub const EFD_CLOEXEC: i32 = libc::O_CLOEXEC;
+/// Flag: semaphore semantics (`read` returns 1 per queued event).
+pub const EFD_SEMAPHORE: i32 = 1;
+
+/// A safe wrapper around an emulated eventfd.
+#[derive(Debug)]
+pub struct EventFd {
+    /// The pollable, readable side.
+    eventfd: File,
+    /// The side `write` goes to when this object owns both ends.
+    wfd: Option<File>,
+    semaphore: bool,
+}
+
+fn set_nonblock(fd: RawFd, on: bool) -> io::Result<()> {
+    // SAFETY: fcntl on a descriptor we own.
+    let flags = unsafe { fcntl(fd, F_GETFL) };
+    if flags < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let flags = if on { flags | O_NONBLOCK } else { flags & !O_NONBLOCK };
+    // SAFETY: as above.
+    if unsafe { fcntl(fd, F_SETFL, flags) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+impl EventFd {
+    /// Create a new EventFd with an initial value of 0.
+    ///
+    /// `flag` is a mask of `EFD_NONBLOCK`, `EFD_CLOEXEC` (implied) and
+    /// `EFD_SEMAPHORE`.
+    pub fn new(flag: i32) -> result::Result<EventFd, io::Error> {
+        let mut fds: [c_int; 2] = [-1, -1];
+        // SAFETY: fds is a valid array of two ints; the result is checked.
+        let ret = unsafe { socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, fds.as_mut_ptr()) };
+        if ret < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: both descriptors are fresh and owned by us from here on.
+        let (rfd, wfd) = unsafe { (File::from_raw_fd(fds[0]), File::from_raw_fd(fds[1])) };
+        // Writes never block (an eventfd write only blocks on counter
+        // overflow); the read side blocks unless asked not to.
+        set_nonblock(wfd.as_raw_fd(), true)?;
+        set_nonblock(rfd.as_raw_fd(), flag & EFD_NONBLOCK != 0)?;
+        Ok(EventFd {
+            eventfd: rfd,
+            wfd: Some(wfd),
+            semaphore: flag & EFD_SEMAPHORE != 0,
+        })
+    }
+
+    /// Add `v` to the counter: queue one 8-byte value.
+    pub fn write(&self, v: u64) -> result::Result<(), io::Error> {
+        let mut f: &File = self.wfd.as_ref().unwrap_or(&self.eventfd);
+        f.write_all(v.to_ne_bytes().as_slice())
+    }
+
+    /// Read the counter: drain the queued values and return their sum (one
+    /// value in semaphore mode).  Blocks for the first value unless the
+    /// EventFd is non-blocking, in which case `WouldBlock` is returned when
+    /// nothing is queued, like `eventfd(2)`.
+    pub fn read(&self) -> result::Result<u64, io::Error> {
+        let mut buf = [0u8; std::mem::size_of::<u64>()];
+        (&self.eventfd).read_exact(&mut buf)?;
+        let mut total = u64::from_ne_bytes(buf);
+        if self.semaphore {
+            return Ok(total);
+        }
+        loop {
+            let mut pfd = pollfd { fd: self.eventfd.as_raw_fd(), events: POLLIN, revents: 0 };
+            // SAFETY: pfd is a valid pollfd; zero timeout.
+            let n = unsafe { poll(&mut pfd, 1, 0) };
+            if n <= 0 || pfd.revents & POLLIN == 0 {
+                break;
+            }
+            match (&self.eventfd).read_exact(&mut buf) {
+                Ok(()) => total = total.wrapping_add(u64::from_ne_bytes(buf)),
+                Err(ref e) if e.kind() == io::ErrorKind::WouldBlock => break,
+                Err(e) => return Err(e),
+            }
+        }
+        Ok(total)
+    }
+
+    /// Clone this EventFd, both sides included.
+    pub fn try_clone(&self) -> result::Result<EventFd, io::Error> {
+        Ok(EventFd {
+            eventfd: self.eventfd.try_clone()?,
+            wfd: match &self.wfd {
+                Some(w) => Some(w.try_clone()?),
+                None => None,
+            },
+            semaphore: self.semaphore,
+        })
+    }
+}
+
+impl AsRawFd for EventFd {
+    fn as_raw_fd(&self) -> RawFd {
+        self.eventfd.as_raw_fd()
+    }
+}
+
+impl FromRawFd for EventFd {
+    /// Wrap a descriptor received from elsewhere (a pipe end from QEMU, say).
+    /// It is read from or written to, never both.
+    unsafe fn from_raw_fd(fd: RawFd) -> Self {
+        EventFd {
+            eventfd: File::from_raw_fd(fd),
+            wfd: None,
+            semaphore: false,
+        }
+    }
+}
+
+impl IntoRawFd for EventFd {
+    /// Hands out the readable side; the write side, if any, is kept open on
+    /// purpose so that clones made from the returned descriptor keep working.
+    fn into_raw_fd(self) -> RawFd {
+        if let Some(w) = self.wfd {
+            let _ = w.into_raw_fd();
+        }
+        self.eventfd.into_raw_fd()
+    }
+}
+
+#[allow(dead_code)]
+fn _assert_c_void_used(_: *mut c_void) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_new() {
+        EventFd::new(EFD_NONBLOCK).unwrap();
+        EventFd::new(0).unwrap();
+    }
+
+    #[test]
+    fn test_read_write() {
+        let evt = EventFd::new(EFD_NONBLOCK).unwrap();
+        evt.write(55).unwrap();
+        assert_eq!(evt.read().unwrap(), 55);
+    }
+
+    #[test]
+    fn test_write_overflow() {
+        let evt = EventFd::new(EFD_NONBLOCK).unwrap();
+        evt.write(1).unwrap();
+        evt.write(2).unwrap();
+        assert_eq!(evt.read().unwrap(), 3);
+        assert!(evt.read().is_err());
+    }
+
+    #[test]
+    fn test_semaphore() {
+        let evt = EventFd::new(EFD_NONBLOCK | EFD_SEMAPHORE).unwrap();
+        evt.write(1).unwrap();
+        evt.write(1).unwrap();
+        assert_eq!(evt.read().unwrap(), 1);
+        assert_eq!(evt.read().unwrap(), 1);
+        assert!(evt.read().is_err());
+    }
+
+    #[test]
+    fn test_clone() {
+        let evt = EventFd::new(EFD_NONBLOCK).unwrap();
+        let evt_clone = evt.try_clone().unwrap();
+        evt.write(923).unwrap();
+        assert_eq!(evt_clone.read().unwrap(), 923);
+    }
+}
