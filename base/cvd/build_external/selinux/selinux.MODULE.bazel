git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

# Android version is forked from github upstream
git_repository(
    name = "selinux",
    build_file = "@//build_external/selinux:BUILD.selinux.bazel",
    commit = "6f8f496eabd35f28dfa6b4be5fc82e325e1df620",
    remote = "https://android.googlesource.com/platform/external/selinux",
    patch_strip = 1,
    # Hosts without xattrs/netlink/selinuxfs (OpenBSD): keep the label file
    # parsing used by sefcontext_compile/e2fsdroid, stub the kernel interfaces.
    patches = ["@//build_external/selinux:openbsd.patch"],
)
