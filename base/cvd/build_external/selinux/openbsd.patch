diff -ruN a/libselinux/src/selinux_xattr.h b/libselinux/src/selinux_xattr.h
--- a/libselinux/src/selinux_xattr.h
+++ b/libselinux/src/selinux_xattr.h
@@ -0,0 +1,75 @@
+/*
+ * Extended attribute helpers. Linux provides them in <sys/xattr.h>; on hosts
+ * without extended attributes (e.g. OpenBSD) the calls fail with ENOTSUP, so
+ * the file labelling API degrades gracefully while the label file parsing used
+ * by host tools (sefcontext_compile, e2fsdroid) keeps working.
+ */
+#ifndef _SELINUX_XATTR_H_
+#define _SELINUX_XATTR_H_
+
+#if defined(__linux__) || defined(__APPLE__)
+#include <sys/xattr.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#include <sys/types.h>
+
+static inline ssize_t getxattr(const char *path __attribute__((unused)),
+			       const char *name __attribute__((unused)),
+			       void *value __attribute__((unused)),
+			       size_t size __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+
+static inline ssize_t lgetxattr(const char *path __attribute__((unused)),
+				const char *name __attribute__((unused)),
+				void *value __attribute__((unused)),
+				size_t size __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+
+static inline ssize_t fgetxattr(int fd __attribute__((unused)),
+				const char *name __attribute__((unused)),
+				void *value __attribute__((unused)),
+				size_t size __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+
+static inline int setxattr(const char *path __attribute__((unused)),
+			   const char *name __attribute__((unused)),
+			   const void *value __attribute__((unused)),
+			   size_t size __attribute__((unused)),
+			   int flags __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+
+static inline int lsetxattr(const char *path __attribute__((unused)),
+			    const char *name __attribute__((unused)),
+			    const void *value __attribute__((unused)),
+			    size_t size __attribute__((unused)),
+			    int flags __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+
+static inline int fsetxattr(int fd __attribute__((unused)),
+			    const char *name __attribute__((unused)),
+			    const void *value __attribute__((unused)),
+			    size_t size __attribute__((unused)),
+			    int flags __attribute__((unused)))
+{
+	errno = ENOTSUP;
+	return -1;
+}
+#endif
+
+#endif /* _SELINUX_XATTR_H_ */
