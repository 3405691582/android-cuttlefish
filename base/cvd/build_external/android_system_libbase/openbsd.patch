@@ -506,6 +511,29 @@
   if (result == 0 || result == sizeof(path) - 1) return "";
   path[PATH_MAX - 1] = 0;
   return path;
+#elif defined(__OpenBSD__)
+  // OpenBSD has neither /proc nor KERN_PROC_PATHNAME, so the best we can do is
+  // to resolve argv[0] like the shell did.
+  int mib[] = {CTL_KERN, KERN_PROC_ARGS, getpid(), KERN_PROC_ARGV};
+  size_t size = 0;
+  if (sysctl(mib, arraysize(mib), nullptr, &size, nullptr, 0) == -1) return "";
+  std::vector<char> buf(size);
+  if (sysctl(mib, arraysize(mib), buf.data(), &size, nullptr, 0) == -1) return "";
+  const char* argv0 = reinterpret_cast<char**>(buf.data())[0];
+  if (argv0 == nullptr) return "";
+  std::string candidate = argv0;
+  if (candidate.find('/') == std::string::npos) {
+    const char* path_env = getenv("PATH");
+    for (const std::string& dir : Split(path_env ? path_env : _PATH_DEFPATH, ":")) {
+      std::string attempt = (dir.empty() ? "." : dir) + "/" + candidate;
+      if (access(attempt.c_str(), X_OK) == 0) {
+        candidate = attempt;
+        break;
+      }
+    }
+  }
+  std::string path;
+  return Realpath(candidate, &path) ? path : candidate;
 #elif defined(__EMSCRIPTEN__)
   abort();
 #else
