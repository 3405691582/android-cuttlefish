diff -ruN a/include/android-base/endian.h b1/include/android-base/endian.h
--- a/include/android-base/endian.h	2026-10-10 06:56:18.383473851 +0000
+++ b1/include/android-base/endian.h	2026-10-10 06:56:31.920426205 +0000
@@ -47,6 +47,18 @@
 #define letoh64(x) le64toh(x)
 #endif
 
+#elif defined(__OpenBSD__)
+
+/* bionic's <sys/endian.h> originally came from OpenBSD. */
+#include <sys/endian.h>
+
+/* OpenBSD keeps htons and htonl in <netinet/in.h>. */
+#include <netinet/in.h>
+
+/* OpenBSD doesn't have the 64-bit variants. */
+#define htonq(x) htobe64(x)
+#define ntohq(x) be64toh(x)
+
 #else
 
 #if defined(__APPLE__)
