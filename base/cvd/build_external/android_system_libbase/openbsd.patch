diff -ruN a/file.cpp b1/file.cpp
--- a/file.cpp	2026-10-10 06:56:18.368071187 +0000
+++ b1/file.cpp	2026-10-10 06:56:31.905994619 +0000
@@ -506,6 +506,10 @@
   if (result == 0 || result == sizeof(path) - 1) return "";
   path[PATH_MAX - 1] = 0;
   return path;
+#elif defined(__OpenBSD__)
+  char path[PATH_MAX];
+  if (getexecpath(path, sizeof(path)) == -1) return "";
+  return path;
 #elif defined(__EMSCRIPTEN__)
   abort();
