+/// Returns the file descriptors currently open in this process. Without procfs (the BSDs, macOS)
+/// every possible descriptor is probed with `fcntl(F_GETFD)`, which fails with EBADF when it is
+/// not open.
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+fn open_fds() -> Result<Vec<RawFd>, std::io::Error> {
+    use nix::fcntl::F_GETFD;
+
+    // SAFETY: sysconf has no preconditions.
+    let open_max = unsafe { libc::sysconf(libc::_SC_OPEN_MAX) };
+    let open_max = RawFd::try_from(open_max).unwrap_or(RawFd::MAX);
+
+    Ok((0..open_max).filter(|raw_fd| fcntl(*raw_fd, F_GETFD).is_ok()).collect())
 }
 
